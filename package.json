{
    "name": "penguinmod-backendapi",
    "version": "1.0.0",
    "description": "The Backend API for PenguinMod",
    "homepage": "https://github.com/PenguinMod/PenguinMod-BackendApi#readme",
    "bugs": {
        "url": "https://github.com/PenguinMod/PenguinMod-BackendApi/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PenguinMod/PenguinMod-BackendApi.git"
    },
    "license": "MIT",
    "author": "",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch index.ts",
        "build": "tsc && cp -r static dist",
        "build-prod": "swc . -d dist --ignore '**/node_modules/**','**/dist/**' && cp -r static dist",
        "start": "node --enable-source-maps dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "gen:routes": "node scripts/gen_routes.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "body-parser": "^1.20.4",
        "colors": "^1.4.0",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "disposable-email-domains": "^1.0.62",
        "dotenv": "^16.3.1",
        "express": "^5.3.0",
        "express-rate-limit": "^7.1.3",
        "google-auth-library": "^9.9.0",
        "ipaddr.js": "^2.2.0",
        "jszip": "^3.10.1",
        "minio": "^8.0.7",
        "mmmagic": "^0.5.3",
        "mongodb": "^6.2.0",
        "multer": "^2.3.0",
        "node-mailjet": "^6.0.6",
        "path": "^0.12.7",
        "pmp-protobuf": "^1.9.0",
        "request-ip": "^3.3.0",
        "sharp": "^0.35.5",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@swc/cli": "^0.8.2",
        "@swc/core": "^1.16.22",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/disposable-email-domains": "^1.0.6",
        "@types/express": "^5.0.6",
        "@types/mmmagic": "^0.4.33",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/request-ip": "^0.0.41",
        "eslint": "^10.15.0",
        "globals": "^17.13.0",
        "nodemon": "^3.1.3",
        "protobufjs-cli": "^1.1.3",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
