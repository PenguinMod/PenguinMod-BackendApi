{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": ".",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
    },
    "include": ["**/*.ts", "**/*.js", "**/*.d.ts"],
    "exclude": ["node_modules", "dist"],
}
